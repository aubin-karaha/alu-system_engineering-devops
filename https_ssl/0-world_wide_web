#!/usr/bin/env bash
# Checking domains/subdomains

function doing ()
{
    result=$(dig "$1.$2" +noall +answer | awk -v subdomain="$1" '{
        print "The subdomain " subdomain " is a " $4 " record and points to " $5
    }')
    echo "$result"
}

if [ -n "$2" ]; then
    doing "$2" "$1"
else
    doing "www" "$1"
    doing "lb-01" "$1"
    doing "web-01" "$1"
    doing "web-02" "$1"
fi
