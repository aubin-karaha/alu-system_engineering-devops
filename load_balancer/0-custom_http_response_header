#!/usr/bin/env bash
# Installs nginx with a custom X-Served-By header containing the hostname
apt-get update
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
sed -i '/^[[:space:]]*server[[:space:]]*{/a\    add_header X-Served-By $hostname;' /etc/nginx/sites-available/default
nginx -t
service nginx restart
