#!/usr/bin/env bash
# Install and configure HAProxy to distribute traffic between web-01 and web-02

apt-get update
apt-get install -y haproxy

cat > /etc/haproxy/haproxy.cfg <<'EOF'
frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7317-web-01 35.176.235.173:80 check
    server 7317-web-02 WEB02_IP:80 check
EOF

service haproxy restart
