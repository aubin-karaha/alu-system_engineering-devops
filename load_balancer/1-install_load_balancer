#!/usr/bin/env bash
# Install and configure HAProxy to distribute traffic between web-01 and web-02

apt-get update
apt-get install -y haproxy

sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy

cat > /etc/haproxy/haproxy.cfg <<'CONFIG'
global
    daemon
    maxconn 256

defaults
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server web-01 35.176.235.173:80 check
    server web-02 7317-web-02:80 check
CONFIG

haproxy -c -f /etc/haproxy/haproxy.cfg

service haproxy restart

echo "Configured web-01 and web-02 with roundrobin load balancing."
